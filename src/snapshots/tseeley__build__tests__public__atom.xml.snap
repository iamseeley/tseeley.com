&lt;/span&gt;&lt;span style=&quot;color:#e2e2e5;&quot;&gt;    println!&lt;/span&gt;&lt;span style=&quot;color:#888888;&quot;&gt;(&amp;quot;&lt;/span&gt;&lt;span style=&quot;font-style:italic;color:#daa520;&quot;&gt;hello&lt;/span&gt;&lt;span style=&quot;color:#888888;&quot;&gt;&amp;quot;);
&lt;/span&gt;&lt;span style=&quot;color:#888888;&quot;&gt;}
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;
&lt;p&gt;A &lt;a href=&quot;/about/&quot;&gt;local link&lt;/a&gt; and an &lt;a href=&quot;https://example.com&quot;&gt;external link&lt;/a&gt;.&lt;/p&gt;
